.ap-back-dashboard {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding: 9px 15px;
  border: 1px solid #00c4b3;
  border-radius: 8px;
  background: #052b35;
  color: #ffffff;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease;
}

.ap-back-dashboard:hover {
  background: #00a99b;
  transform: translateY(-1px);
}
